{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "Bundler",
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "@playwright/test"], 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["tests", "controllers", "models", "utils", "lib"]
}